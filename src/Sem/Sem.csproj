<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Sem</AssemblyName>
    <RootNamespace>Sem</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\sem.ico</ApplicationIcon>
    <Product>Sem Ajan</Product>
    <Company>Sem Özel Eğitim ve Rehabilitasyon Merkezi</Company>
    <AssemblyTitle>Sem Bilgisayar Yönetimi</AssemblyTitle>
    <Version>1.7.3</Version>
    
    
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" ExcludeAssets="compile;runtime" GeneratePathProperty="true" />
    <PackageReference Include="DiskInfoToolkit" Version="1.1.2" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="RAMSPDToolkit-NDD" Version="1.4.2" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Threading.AccessControl" Version="10.0.3" />
    <Reference Include="LibreHardwareMonitorLib">
      <HintPath>$(PkgLibreHardwareMonitorLib)\runtimes\win-x64\lib\net472\LibreHardwareMonitorLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Management" />
  </ItemGroup>
  <!-- Sıcaklık/fan okuma kütüphanesi ve bağımlılıkları Sem.exe'nin içine gömülür (tek dosya kalır);
       Program.Main'deki AssemblyResolve bunları kaynaklardan yükler. -->
  <Target Name="BagimliliklariGom" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'" LogicalName="lib.%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="..\..\assets\duvar.png" LogicalName="duvar.png" />
    <EmbeddedResource Include="..\..\assets\ikon.ttf" LogicalName="ikon.ttf" />
  </ItemGroup>
</Project>
